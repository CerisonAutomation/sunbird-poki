# Multiplayer race server — the Rust `sunbird-server` crate in rust/
# serves the legacy simple protocol on GET /ws. It is fully self-hosted:
# run it locally with:
#
#   cargo run --release -p sunbird-server    # listens on :8080
#
# Local dev: the vite proxy already forwards /mp → localhost:8080/ws, so the
# client connects same-origin (no CORS) through any tunnel/preview host:
VITE_MULTIPLAYER_URL=/mp
#
# Production: point at the deployed Rust server instead:
# VITE_MULTIPLAYER_URL=wss://mp.example.com

# Global leaderboard — served by the Vercel Functions in api/ (see
# LEADERBOARD_API.md). Same-origin on Vercel:
VITE_LEADERBOARD_URL=/api
# Or a hosted leaderboard on another domain:
# VITE_LEADERBOARD_URL=https://api.example.com

# Poki portal build: set this to your Poki game id (the slug in
# https://poki.com/en/g/<game-id>) when publishing through Poki. When present
# AND `VITE_PORTAL_TARGET=poki`, Poki AUDS (Arbitrary User Data Store) is used
# as an additional cloud backend for global leaderboards, ghost sharing, and
# per-user settings sync — no self-hosted backend required for Poki-hosted builds.
# Leave blank for local/dev/non-Poki builds (leaderboards fall back to the
# self-hosted Vercel API, then local).
# The id lives in package.json's `build:poki` script (single source of truth —
# it also sets VITE_POKI_NETLIB_GAME_ID there). Do not paste a second copy here:
# a stale id fails silently, because every AUDS call is skipped and boards fall
# back to local. Confirm the value against the dashboard as described in
# docs/poki/08-game-dev-tools.md (rule TOOL-09).
# VITE_POKI_GAME_ID=00000000-0000-0000-0000-000000000000   # placeholder shape only

# Shared salt for HMAC-signed leaderboard submissions.
# Client sets VITE_LEADERBOARD_SALT; the Vercel Function reads LEADERBOARD_SALT
# (the self-hosted TS backend reads SUNBIRD_LEADERBOARD_SALT).
# REQUIRED for production: with VERCEL_ENV=production / NODE_ENV=production and
# no salt, the score endpoint fails closed (503) instead of running open.
# Previews/dev without a salt stay lenient (memory-only boards).
# VITE_LEADERBOARD_SALT=change-me-together-with-server

# Upstash Redis for the leaderboard functions (create a Redis database, then add
# its KV_REST_API_URL + KV_REST_API_TOKEN to the Vercel project env). Required
# for production; local/preview runs may use the in-memory board.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Social server (friends/clubs/chat) — the TS social service in server/.
# Local dev: vite proxies /social → localhost:8791 automatically.
VITE_SOCIAL_URL=/social
# ↑ also the aggregate telemetry beacon target (POST {base}/telemetry on tab-hide)
# Production: point at the deployed social server:
# VITE_SOCIAL_URL=https://social.example.com

# One-time First Flight Pack ($0.99) Stripe Payment Link
# Portal builds (build:poki/crazy/generic) blank this by design — portals are
# coin-only; the standalone/Vercel build is the only place it takes effect.

# --------------------------------------------------------------- Docker Compose
# For `docker compose up -d --build` (see DEPLOY.md). Copy to .env and set the
# two REQUIRED secrets:
#   SUNBIRD_RECONNECT_HMAC_SECRET="$(openssl rand -hex 32)"
#   SUNBIRD_TOKEN_SECRET="$(openssl rand -hex 32)"
#
# Everything else has a working default for local use.

# development | staging | production
# production additionally requires explicit https origins in
# SUNBIRD_PUBLIC_ORIGINS and non-default secrets.
SUNBIRD_ENV=development

# Browser origins the Rust server accepts (comma-separated).
# "*" is only allowed in development.
SUNBIRD_PUBLIC_ORIGINS=*

# Host ports (leave default for local use).
SUNBIRD_MP_PORT=8080
SUNBIRD_SOCIAL_PORT=8791

# Reconnect-token grace window (1-300 s) and shutdown grace (1-60 s).
SUNBIRD_RECONNECT_GRACE_SECONDS=30
SUNBIRD_SHUTDOWN_GRACE_SECONDS=5

# Prometheus metrics bind address; empty disables.
SUNBIRD_METRICS_BIND_ADDR=0.0.0.0:9090

# Social backend: key for moderation routes (X-Moderator-Key), and the
# public base URL used in share links.
SUNBIRD_MODERATION_KEY=
SUNBIRD_PUBLIC_BASE_URL=http://localhost:5173

# 1 = persist social data as JSON files in the social-data volume.
SUNBIRD_PERSIST=1
